ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=numm_ai
DB_USER=sih
DB_PASSWORD=change-me
DB_SSL=false
DB_SSLMODE=prefer
DB_ECHO=false

# Full URL. Leave unset to use the DB_* parts above.
# DATABASE_URL=

# ============================================================================
# PHASE 1 - raw text/CSV/XLSX -> the eight canonical CPSE attributes
#
# The extraction engine (app/logic/extraction.py) is vendored from
# backend/pipeline-one. It runs a fine-tuned Qwen2.5-3B with the
# qwen2.5-3b-cpse-lora-v2 adapter in 4-bit NF4, ~2.0 GB of VRAM.
# ============================================================================

# OFF by default, like EMBEDDING_PROVIDER below. The vector half of this
# service runs, demos and passes every test with no model weights present:
# /extract/* answers 503 and says so, and GET /extract/info always reports the
# real state, so nothing can silently claim fine-tuned extraction it is not
# doing. Turn it on and install requirements-ml.txt to extract here.
EXTRACTION_ENABLED=false

# The LoRA weights are NOT copied into this service - they are 195 MB and are
# already tracked under backend/pipeline-one/models/. This points at them.
# For a standalone ai-service image, set it to
# data/models/qwen2.5-3b-cpse-lora-v2 and unzip the GitHub release there.
LORA_ADAPTER_DIR=../pipeline-one/models/qwen2.5-3b-cpse-lora-v2
BASE_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
EXTRACTION_MAX_NEW_TOKENS=256

# Review sessions: what the model predicted and what a reviewer corrected.
# Working state, deliberately outside Postgres - nothing in a session is part
# of the master until POST /standardized/add accepts it.


# The CPSE abbreviation taxonomy the engine expands against. The only
# reference data this service still carries.
CONFIG_DIR=data/config

# ============================================================================
# THE BOUNDARY - is this standard-format row already in the vector DB?
# ============================================================================

# Cosine at or above which an incoming row is judged to ALREADY EXIST.
# The one tunable that decides what enters the master: too low and genuinely
# new material is dropped as a duplicate, too high and the index fills with
# re-uploads. 0.90 is deliberately strict - holding a real duplicate back
# costs a re-check, admitting one costs a reviewer.
EXISTENCE_THRESHOLD=0.90

# Neighbours fetched per row. Only the best one can decide; a short list makes
# the response explainable.
EXISTENCE_TOP_K=5

# Constrain the duplicate check to the incoming row's material family.
# OFF, and the default is the important part: blocking narrows the traversal,
# but a row the keyword table (app/logic/category.py) put in the wrong family
# would then never be compared against its own duplicate - and a missed
# duplicate is the failure this endpoint exists to prevent. An unblocked HNSW
# search is sublinear, so the speedup is real but secondary. Turn it on when
# the corpus is big enough for the scan to cost something AND the table has
# earned trust on your data. UNCLASSIFIED rows are never blocked either way.
EXISTENCE_BLOCK_BY_CATEGORY=false

# How long a check nobody acted on is kept. A batch stages a full copy of every
# row it judged new, so an abandoned preview is pure weight. Batches that were
# ADDED are never pruned - they are the audit trail, and the staged copy is
# dropped once the rows are in `material`. 0 disables pruning.
BATCH_RETENTION_DAYS=7

# ============================================================================
# THE VECTOR - embeddings and the store
# ============================================================================

#   deterministic  seeded hash - no torch, no download, similarity MEANINGLESS
#   qwen3          Qwen/Qwen3-Embedding-0.6B, 1024-d, needs requirements-ml.txt
# GET /api/v1/retrieval/model/info always reports which one is live.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_VERSION=qwen3-0.6b-v1
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# memory - exact O(N) search in-process, dies with the worker. Fine for tests
#          and a laptop demo, unusable past a few thousand vectors.
# qdrant - a real server, survives restarts, shared by every worker.
#
# There is no rebuild endpoint: POST /standardized/add writes the master and the
# index in one transaction, so an unreachable store fails the add and writes
# nothing. With VECTOR_STORE=memory the index dies with the process while
# Postgres keeps the rows, and the two then disagree permanently - use qdrant
# for anything whose data you intend to keep.
VECTOR_STORE=memory

# Local container (docker compose up -d qdrant):
QDRANT_URL=http://127.0.0.1:6333
# Qdrant Cloud - take the endpoint from the console. No port needed; the
# managed cluster serves REST on 443.
# QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io

# Required by Qdrant Cloud, ignored by a local container. This is a bearer
# credential: whoever holds it can read and delete every vector in the
# cluster, so it belongs in .env (gitignored) and never here.
QDRANT_API_KEY=

QDRANT_COLLECTION=material_embeddings
# A cloud cluster adds real network latency; 10s is tight for a bulk upsert.
QDRANT_TIMEOUT=10.0
# gRPC (port 6334) is faster for bulk upsert but needs that port reachable.
# REST over 443 works everywhere, so it is the default.
QDRANT_PREFER_GRPC=false
HNSW_M=16
HNSW_EF_CONSTRUCT=128

# Reported by /retrieval/model/info and /search/model/info.
ANN_ENABLED=true
TOP_K=10

# ============================================================================
# SEARCH / HARMONIZATION - POST /search
#
#   query -> exact identifier lookup (Postgres)
#         -> Qwen3 query vector -> Qdrant top-K
#         -> Siamese reranker over those K, one batch
#         -> fused score, three-way match level
# ============================================================================

# Candidates the vector store returns and the reranker scores. The reranker
# never sees anything Qdrant did not surface first.
SEARCH_TOP_K=20
# Results returned by default; a caller may ask for up to SEARCH_TOP_K.
SEARCH_FINAL_K=5
# Ceiling on a caller's top_k.
SEARCH_MAX_TOP_K=100

# Load the trained Siamese reranker. With no checkpoint at SIAMESE_MODEL_PATH
# (or no torch) the search still answers, ordered by the Qdrant score, with
# siamese_score null and the response saying the reranker was not applied -
# and no result can then be a high-confidence match. GET /search/model/info
# reports which state is live.
SEARCH_RERANKER_ENABLED=true

# Written by scripts/train_siamese.py. Not in git (~90 MB); train it:
#   .venv/bin/python scripts/train_siamese.py \
#       --corpus ../pipeline-one/CPSE_SIH26099.csv \
#       --pairs data/training/seed_pairs.csv
SIAMESE_MODEL_PATH=data/models/siamese-cpse-v1
# The pretrained encoder the reranker is fine-tuned FROM (training only; a
# checkpoint carries its own copy). 22 M parameters - it reranks twenty
# candidates in ~15 ms on a CPU. Deliberately not the 0.6 B retrieval model.
SIAMESE_BASE_MODEL=sentence-transformers/all-MiniLM-L6-v2
SIAMESE_DEVICE=cpu
SIAMESE_BATCH_SIZE=64

# final_score = QDRANT_WEIGHT * qdrant_score + SIAMESE_WEIGHT * siamese_score.
# Must sum to 1. Both are cosines but from different spaces: on the reference
# corpus the Qwen3 cosine puts a true match at ~0.68 and a near-miss article
# (V BELT C 125 vs C-120) at ~0.70, while the Siamese score puts them at
# ~0.95 and ~0.3. The default leans on the trained stage for that reason.
SEARCH_QDRANT_WEIGHT=0.3
SEARCH_SIAMESE_WEIGHT=0.7

# Match levels on final_score:  >= MATCH -> high,  >= POSSIBLE -> possible,
# else none. 0.75 is what scripts/evaluate_search.py --calibrate found on the
# reference corpus for the weights above; recalibrate after every retrain.
SEARCH_MATCH_THRESHOLD=0.75
SEARCH_POSSIBLE_THRESHOLD=0.55

# ============================================================================
# BACKGROUND JOBS
#
# Three endpoints do work bounded by the size of the input rather than by an
# HTTP timeout - /extract/csv, /standardized/check and /standardized/add. They
# record a job, return its id and answer 202 unless they finish within the
# caller's `wait`.
# ============================================================================

# How many may run at once. These are CPU-, GPU- and memory-heavy; an
# unbounded number of them turns a slow service into a dead one.
MAX_CONCURRENT_JOBS=2

# Seconds a submitting endpoint waits inline before returning 202.
# 0 = always answer immediately with a job id (best for batch clients).
# 5 = an interactive upload usually gets its answer inline, and only genuinely
#     large work degrades to the poll path. Nothing breaks either way.
JOB_DEFAULT_WAIT_SECONDS=0.0

# Ceiling on the `wait` query parameter, whatever a caller asks for. Keep this
# below any proxy or load-balancer read timeout in front of the service.
JOB_MAX_WAIT_SECONDS=60.0

# --- Remaining tunables (defaults; rarely changed) --------------------------
PROJECT_NAME=NUMM AI Service
API_V1_PREFIX=/api/v1

# ============================================================================
# AUTHENTICATION
#
# There is none, and there is no user model: no roles, no caller identity, no
# headers read to decide anything. api-service owns all of that. Every
# endpoint answers a completely empty request.
#
# Attribution is an optional "actor"/"requested_by" label in the request body,
# recorded on the audit entry. Unverified free text - a label, never an
# identity.
#
# THE SECURITY BOUNDARY IS THE NETWORK. Do not route port 8001 publicly.
# ============================================================================

----------------
# Bikram

# ==============================================================================
# AI Service Environment Variables
# ==============================================================================
PROJECT_NAME="sih-2026 ai-service"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8001

MODEL_PROVIDER=local
MODEL_NAME=stub-model-v0
MAX_INPUT_CHARS=8000
REQUEST_TIMEOUT=120.0

CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]