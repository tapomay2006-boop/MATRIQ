# ==============================================================================
# API Service Environment Variables
# ==============================================================================
PROJECT_NAME="sih-2026 api-service"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

# Database Connection (Neon PostgreSQL / Local Postgres)
# Paste your Neon connection string directly:
# e.g. DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# The service automatically normalizes to asyncpg and applies SSL.
DATABASE_URL=postgresql+asyncpg://sih:sih@localhost:5432/sih

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=60.0

CORS_ORIGINS=["http://localhost:3000"]
