# ==============================================================================
# SIH-2026 Root Environment Variables
# ==============================================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=sih
POSTGRES_PASSWORD=sih
POSTGRES_DB=sih
POSTGRES_PORT=5432

# --- Service Ports ---
API_SERVICE_PORT=8000
AI_SERVICE_PORT=8001
QDRANT_PORT=6333
FRONTEND_PORT=3000

# --- Security / JWT Secret ---
SECRET_KEY=change-me-in-production

# --- Frontend & Auth ---
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH_SECRET=change-me-to-a-secure-random-string
NEXTAUTH_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/sih_db
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- AI Service Configuration ---
MODEL_PROVIDER=local
MODEL_NAME=stub-model-v0
MAX_INPUT_CHARS=8000

# --- Embedding / Vector DB ---
QDRANT_COLLECTION=material_embeddings
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
TOP_K=10